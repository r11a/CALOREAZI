#!/usr/bin/with-contenv sh
set -eu

PGDATA=/data/postgres
install -d -o postgres -g postgres -m 0700 "$PGDATA"

if [ ! -s "$PGDATA/PG_VERSION" ]; then
  # PostgreSQL only listens on loopback inside the add-on container. Trust is
  # limited to that private boundary; Home Assistant and LAN clients cannot
  # reach port 5432 because it is neither exposed nor proxied.
  su-exec postgres initdb -D "$PGDATA" --auth-local=trust --auth-host=trust
  printf "listen_addresses='127.0.0.1'\nport=5432\n" >> "$PGDATA/postgresql.conf"
fi

exec su-exec postgres postgres -D "$PGDATA"
