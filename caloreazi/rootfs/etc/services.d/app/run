#!/usr/bin/with-contenv sh
set -eu

cd /opt/caloreazi
export HOSTNAME=127.0.0.1
export PORT=3000
export CALOREAZI_DATABASE_URL="${CALOREAZI_DATABASE_URL:-postgresql://postgres@127.0.0.1:5432/caloreazi}"

attempt=0
until su-exec postgres createdb -h 127.0.0.1 -U postgres caloreazi 2>/dev/null || su-exec postgres psql -h 127.0.0.1 -U postgres -d caloreazi -c 'select 1' >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 30 ]; then
    echo "CALOREAZI database did not become ready" >&2
    exit 1
  fi
  sleep 1
done

node scripts/migrate.mjs
exec npm run start -- --hostname 127.0.0.1 --port 3000
